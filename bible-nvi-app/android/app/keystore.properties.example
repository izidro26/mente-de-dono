# Copie este arquivo para "keystore.properties" (no mesmo diretório) e
# preencha com os dados da SUA keystore de release. Esse arquivo (sem o
# ".example") já está no .gitignore — nunca vai parar no repositório.
#
# Para gerar uma keystore nova (se ainda não tiver uma):
#   keytool -genkeypair -v -keystore verbo-release.keystore \
#     -alias verbo -keyalg RSA -keysize 2048 -validity 10000
#
# Guarde o arquivo .keystore e essas senhas em local seguro — se você
# perder a keystore, não há como atualizar o mesmo app já publicado na
# Play Store; seria necessário publicar como um app novo.

storeFile=/caminho/absoluto/para/verbo-release.keystore
storePassword=troque-esta-senha
keyAlias=verbo
keyPassword=troque-esta-senha
